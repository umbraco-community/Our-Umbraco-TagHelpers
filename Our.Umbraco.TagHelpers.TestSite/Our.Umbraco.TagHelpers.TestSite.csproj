<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The demo site runs Umbraco 17 (LTS) by default. Pass -p:UmbracoVersion=16|17|18|19 to build/run
    it against another supported Umbraco major, e.g. for the cross-version Playwright tests.
    UmbracoVersion is defaulted in Directory.Build.props, which also gives each version its own bin/obj.
  -->
  <PropertyGroup Condition="'$(UmbracoVersion)' == '16'">
    <TargetFramework>net9.0</TargetFramework>
    <UmbracoCmsVersion>16.5.1</UmbracoCmsVersion>
    <USyncVersion>16.1.0</USyncVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoVersion)' == '17'">
    <TargetFramework>net10.0</TargetFramework>
    <UmbracoCmsVersion>17.8.1</UmbracoCmsVersion>
    <USyncVersion>17.6.2</USyncVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoVersion)' == '18'">
    <TargetFramework>net10.0</TargetFramework>
    <UmbracoCmsVersion>18.3.1</UmbracoCmsVersion>
    <USyncVersion>18.3.1</USyncVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UmbracoVersion)' == '19'">
    <TargetFramework>net11.0</TargetFramework>
    <UmbracoCmsVersion>19.0.0-rc1</UmbracoCmsVersion>
    <USyncVersion>19.0.0-rc1</USyncVersion>
  </PropertyGroup>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
    <LangVersion>default</LangVersion>
  </PropertyGroup>

  <Target Name="ValidateUmbracoVersion" BeforeTargets="Restore;_CheckForInvalidConfigurationAndPlatform" Condition="'$(UmbracoCmsVersion)' == ''">
    <Error Text="Unsupported UmbracoVersion '$(UmbracoVersion)'. Use 16, 17, 18 or 19." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="$(UmbracoCmsVersion)" />
    <PackageReference Include="Umbraco.Cms.Core" Version="$(UmbracoCmsVersion)" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="$(UmbracoCmsVersion)" />
    <PackageReference Include="uSync" Version="$(USyncVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Our.Umbraco.TagHelpers\Our.Umbraco.TagHelpers.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Views are compiled at build time: Umbraco 17+ no longer ships runtime Razor compilation,
         and this site uses ModelsMode SourceCodeManual -->
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
    <RazorCompileOnPublish>true</RazorCompileOnPublish>
  </PropertyGroup>

</Project>
