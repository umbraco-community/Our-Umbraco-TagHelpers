@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Home>
@using Umbraco.Cms.Core.Models
@{
    // Umbraco 19 returns a list from MediaPicker3 even when it is limited to one item
    // (single pickers moved to Umbraco.MediaPicker.Single), so resolve the logo either way.
    MediaWithCrops? logo = Model.Value("logo") switch
    {
        MediaWithCrops single => single,
        IEnumerable<MediaWithCrops> many => many.FirstOrDefault(),
        _ => null
    };
}

<h2>our-svg</h2>
<p>
    This tag helper element our-svg will read the file contents of an SVG file and 
    output it as an inline SVG in the DOM. It can be used in one of two ways, either 
    by specifying the src attribute to a physical static file served from wwwRoot 
    or by specifying the media-item attribute to use a picked IPublishedContent Media Item.
</p>


<div style="border:2px solid red; max-width: 25vw">
    <our-svg src="/samples/partying-face.svg" ensure-viewbox="true" />
</div>

<div style="border:2px solid green; max-width: 25vw">
    <our-svg media-item="logo" ensure-viewbox="true" />
</div>

<h3>Options</h3>

<p>A <code>class</code> is added to the inlined &lt;svg&gt;:</p>
<div data-demo="class" style="max-width: 10vw">
    <our-svg src="/samples/partying-face.svg" class="demo-svg demo-svg--large" />
</div>

<p>
    This site sets <code>Our.Umbraco.TagHelpers:OurSVG:EnsureViewBox</code> to true in appsettings.json,
    so a viewBox is added even without the <code>ensure-viewbox</code> attribute:
</p>
<div data-demo="appsettings" style="max-width: 10vw">
    <our-svg src="/samples/partying-face.svg" />
</div>

<p><code>ignore-appsettings</code> uses only the attributes on the tag, so this one keeps its width and height and gets no viewBox:</p>
<div data-demo="ignore-appsettings" style="max-width: 10vw">
    <our-svg src="/samples/partying-face.svg" ignore-appsettings="true" />
</div>

<p>
    <code>cache</code> keeps the file contents in Umbraco's runtime cache (for <code>cache-minutes</code>, default 180),
    so changes to the file only show once the cache expires. The second copy of the same file is not cached:
</p>
<div data-demo="cached" style="display: inline-block">
    <our-svg src="/samples/cache-demo.svg" cache="true" cache-minutes="5" />
</div>
<div data-demo="uncached" style="display: inline-block">
    <our-svg src="/samples/cache-demo.svg" />
</div>
<p>
    Cached copies of the same file share one cache entry, but each keeps its own <code>class</code>:
    only the file contents are cached, not the rendered tag.
</p>
<div data-demo="cached-class-a" style="display: inline-block; max-width: 5vw">
    <our-svg src="/samples/partying-face.svg" cache="true" class="demo-svg-a" />
</div>
<div data-demo="cached-class-b" style="display: inline-block; max-width: 5vw">
    <our-svg src="/samples/partying-face.svg" cache="true" class="demo-svg-b" />
</div>

<p>
    A cached SVG from the media library is cleared when media is saved, on every server of a load-balanced site,
    so a new file shows straight away:
</p>
<div data-demo="cached-media" style="display: inline-block; max-width: 5vw">
    <our-svg media-item="logo" cache="true" />
</div>

<p>
    These two SVGs both style their circle with the class <code>.st0</code> in an inline &lt;style&gt;, one blue and one red.
    Inlined as they are, the last <code>.st0</code> rule on the page wins, so both circles are the same colour:
</p>
<div data-demo="unscoped-blue" style="display: inline-block"><our-svg src="/samples/style-blue.svg" /></div>
<div data-demo="unscoped-red" style="display: inline-block"><our-svg src="/samples/style-red.svg" /></div>
<p>With <code>scope-styles</code>, each SVG's &lt;style&gt; only applies to that SVG, so each keeps its own colour:</p>
<div data-demo="scoped-blue" style="display: inline-block"><our-svg src="/samples/style-blue.svg" scope-styles="true" /></div>
<div data-demo="scoped-red" style="display: inline-block"><our-svg src="/samples/style-red.svg" scope-styles="true" /></div>

<p>
    SVGs are inlined into the page, so <code>our-svg</code> removes anything in them that could run script:
    scripts, event handlers such as <code>onload</code>, <code>foreignObject</code> and script links.
    This one has all of those, and renders as a plain circle:
</p>
<div data-demo="unsafe" style="display: inline-block">
    <our-svg src="/samples/unsafe.svg" />
</div>

<p>
    Other attributes on <code>our-svg</code>, such as <code>aria-hidden</code>, <code>role</code>, <code>id</code>,
    <code>data-*</code> or <code>width</code>, are copied onto the inlined <code>&lt;svg&gt;</code>:
</p>
<div data-demo="attributes" style="display: inline-block; max-width: 5vw">
    <our-svg src="/samples/partying-face.svg" aria-hidden="true" id="decorative-face" data-track="demo-face" width="32" />
</div>
