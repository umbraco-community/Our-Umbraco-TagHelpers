@using Our.Umbraco.TagHelpers.TestSite.Models
@model ContactFormViewModel

<h2>Replacement for BeginUmbracoForm</h2>
<p>
    This is to make it easier to create a HTML form that uses an Umbraco SurfaceController 
    and would be an alternative of using the Html.BeginUmbracoForm approach. 
    This taghelper runs against the form element along with these attributes our-controller
    and our-action to help generate a hidden input field of ufprt containing 
    the encoded path that this form needs to route to.
</p>

@if (TempData["ContactFormSubmitted"] is string submittedName)
{
    <p class="form-success">Thanks @submittedName, your message was sent.</p>
}

<form our-controller="ContactForm" our-action="Submit" method="post" id="testContactForm" class="form">
    <div asp-validation-summary="All"></div>

    <div class="input-group">
        <p>Name:</p>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <p>Email:</p>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div>
        <p>Message:</p>
        <textarea asp-for="Message"></textarea>
        <span asp-validation-for="Message"></span>
    </div>
    <br/>
    <input type="submit" name="Submit" value="Submit" />
</form>

<h3>With the Controller suffix</h3>
<p>
    <code>our-controller</code> takes the controller's name with or without its <code>Controller</code> suffix,
    so <code>our-controller="ContactFormController"</code> posts to the same controller as the form above.
</p>

<form our-controller="ContactFormController" our-action="Submit" method="post" id="testSuffixForm" class="form">
    <p>Name:</p>
    <input name="Name" />
    <p>Email:</p>
    <input name="Email" />
    <p>Message:</p>
    <textarea name="Message"></textarea>
    <br/>
    <input type="submit" value="Submit" />
</form>

<h3>Surface controllers in an area (umb-area)</h3>
<p>
    Surface controllers marked with <code>[PluginController("...")]</code>, as packages usually do, live in an MVC area.
    Add <code>umb-area</code> with the area name so the ufprt field routes the form to that controller.
</p>

@if (TempData["AreaFormSubmitted"] is string areaName)
{
    <p class="area-form-success">Area form received @areaName</p>
}

<form our-controller="AreaContactForm" our-action="Submit" umb-area="TagHelpersDemo" method="post" id="testAreaForm" class="form">
    <p>Name:</p>
    <input name="name" />
    <button type="submit">Send to the area controller</button>
</form>
