<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Each Umbraco major is tied to a single .NET version, so the TFM selects the Umbraco build:
		     net9.0 = Umbraco 16, net10.0 = Umbraco 17 + 18, net11.0 = Umbraco 19 -->
		<TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
		<!-- The package version: build.ps1, the e2e package tests and CI all pack from this -->
		<Version>2.1.0</Version>
		<LangVersion>default</LangVersion>
		<!-- Audit only the packages referenced here. Umbraco is referenced at the lowest version of each major
		     (so the package installs on every patch), which pulls in old transitive packages; sites resolve
		     and audit their own, newer Umbraco dependencies. -->
		<NuGetAuditMode>direct</NuGetAuditMode>
	</PropertyGroup>

	<PropertyGroup>
		<!-- SourceLink: https://github.com/dotnet/sourcelink -->
		<!-- Embed source files that are not tracked by the source control manager in the PDB -->
		<EmbedUntrackedSources>true</EmbedUntrackedSources>

		<!-- SourceLink: Build symbol package (.snupkg) to distribute the PDB containing Source Link -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>		
	</PropertyGroup>

	<!-- Deterministic Builds: https://github.com/clairernovotny/DeterministicBuilds -->
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>
	
	<PropertyGroup>
		<Company>Umbraco Community</Company>
		<Authors>Warren Buckley</Authors>
		<Description>A community project of C# ASP.NET TagHelpers for the Open Source CMS Umbraco</Description>
		<PackageProjectUrl>https://github.com/umbraco-community/Our-Umbraco-TagHelpers</PackageProjectUrl>
		<RepositoryUrl>https://github.com/umbraco-community/Our-Umbraco-TagHelpers</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>TagHelperLogo.png</PackageIcon>
		<PackageTags>Umbraco;TagHelper;TagHelpers;UmbracoCMS;umbraco-marketplace</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Nullable>enable</Nullable>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Stubble.Core" Version="1.10.8" />
	</ItemGroup>

	<!-- ASP.NET Core comes from the shared framework (via Umbraco), and Source Link is built into the .NET SDK -->

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Umbraco.Cms.Core" Version="16.0.0" />
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="16.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Umbraco.Cms.Core" Version="17.0.0" />
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="17.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<PackageReference Include="Umbraco.Cms.Core" Version="19.0.0-rc1" />
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="19.0.0-rc1" />
	</ItemGroup>

  <ItemGroup>
    <Content Include="buildTransitive\**" PackagePath="buildTransitive" />
  </ItemGroup>

	<ItemGroup>
		<!-- Include files in package -->
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\appsettings-schema.our.umbraco.taghelpers.json" Pack="true" PackagePath="\" />
    <None Include="TagHelperLogo.png" Pack="true" PackagePath="\" />

  </ItemGroup>

</Project>
