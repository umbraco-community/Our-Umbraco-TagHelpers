{/*
	Light (warm paper) is the default for everyone, whatever their system's light or dark setting.
	Dark is used only when someone picks it. Inlined to avoid a flash of the wrong theme.
*/}
<script is:inline>
	(() => {
		let stored = null;
		try {
			stored = localStorage.getItem('starlight-theme');
		} catch {}
		document.documentElement.dataset.theme = stored === 'dark' ? 'dark' : 'light';
	})();
</script>
